#!/usr/bin/env bash
# Refuse a push to main that bootstrap or core.yml would refuse, before it
# lands: rustfmt, clippy -D warnings, and xtask's R1, R4 and R5 gates (validate's but
# audit-bootstrap, which needs the SDK), and,
# when the push touches the MIR path (crates/uorust/src/mir), the core
# register's ratchet on CI's own MIR (scripts/mir/core-gate.sh). Runs in the
# pushing worktree with that lane's own build. Installed by
# `git config core.hooksPath scripts/hooks` (`just hooks`); needs no `just`.
# The lane's cargo flags come from scripts/hooks/lane-cfg.sh ($LANE_N).
set -euo pipefail
zero=0000000000000000000000000000000000000000
# Every ref line first, so nothing the gates run reads them from stdin.
pushed=$(cat)
while read -r _lref lsha rref rsha; do
  [ -n "$rref" ] || continue
  [ "$rref" = refs/heads/main ] || continue
  [ "$lsha" = "$zero" ] && continue
  root=$(git rev-parse --show-toplevel)
  cd "$root"
  . "$root/scripts/hooks/lane-cfg.sh"
  cargo fmt --all -- --check >/dev/null || { echo "pre-push: cargo fmt --check fails; run cargo fmt" >&2; exit 1; }
  # bootstrap's lint, exactly as `just lint` runs it.
  cargo clippy --workspace --all-targets --all-features --locked "${cfg[@]}" -q -- -D warnings \
    || { echo "pre-push: cargo clippy -D warnings refuses this tree (just lint)" >&2; exit 1; }
  # validate's gates but audit-bootstrap, which reads the SDK's inventory
  # and so runs only inside the SDK (bootstrap runs it).
  for gate in check-model audit-limits audit-deferral audit-dependency-updates; do
    cargo run -q --locked -p xtask "${cfg[@]}" -- "$gate" \
      || { echo "pre-push: xtask $gate refuses this tree" >&2; exit 1; }
  done
  # The self model's generators still run on this tree: they cite source
  # lines by a needle that must name one line, and a push that breaks one
  # stops generate.yml, so nothing regenerates and bootstrap stays red.
  work=$(mktemp -d)
  mkdir -p "$work/model" "$work/scripts"
  cp model/routes.toml model/cadence.toml "$work/model/"
  cp Cargo.toml "$work/"
  cp -r scripts/self-model "$work/scripts/"
  tar --exclude=app/.lexlean --exclude=app/.prism --exclude=app/target --exclude=app/.lake -cf - app | tar -C "$work" -xf -
  if ! { python3 -I "$work/scripts/self-model/routes.py" "$work" && python3 -I "$work/scripts/self-model/facets.py" "$work" "$root" &&
    python3 -I "$work/scripts/self-model/release.py" "$work" "$root"; } >/dev/null; then
    rm -rf "$work"
    echo "pre-push: the self model's generators (scripts/self-model) fail on this tree" >&2
    exit 1
  fi
  rm -rf "$work"
  # What the push adds to main: from the remote's main when this clone has
  # it, else from the last fetched origin/main.
  base=$rsha
  if [ "$base" = "$zero" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
    base=$(git merge-base origin/main "$lsha")
  fi
  # The tests of what the push touches: each package whose directory it
  # changes, and uorust's, whose tests read the workflows, the CI scripts,
  # the self model and this workspace's own projection (engine.rs, cli.rs),
  # for a change to any of those.
  packages=()
  for dir in $(git diff --name-only "$base" "$lsha" -- crates | cut -d/ -f2 | sort -u); do
    [ -f "crates/$dir/Cargo.toml" ] || continue
    packages+=(-p "$(sed -n 's/^name = "\(.*\)"/\1/p' "crates/$dir/Cargo.toml" | head -1)")
  done
  if [ -n "$(git diff --name-only "$base" "$lsha" -- .github scripts app model Cargo.toml Cargo.lock)" ]; then
    packages+=(-p uorust)
  fi
  # What those tests read: each touched package's sources, and for
  # uorust's the workflows, scripts, app, model and manifests too. A patch
  # that passed them on an older main is not tested again when main gained
  # nothing it or they read (scripts/hooks/passes.py, lane-push.sh).
  inputs=()
  for dir in $(git diff --name-only "$base" "$lsha" -- crates | cut -d/ -f2 | sort -u); do
    [ -f "crates/$dir/Cargo.toml" ] && inputs+=("crates/$dir/src" "crates/$dir/tests" "crates/$dir/assets" "crates/$dir/Cargo.toml")
  done
  if [[ " ${packages[*]} " == *" uorust "* ]]; then
    inputs+=(crates/uorust/src crates/uorust/tests crates/uorust/assets crates/uorust/Cargo.toml .github scripts app model Cargo.toml Cargo.lock)
  fi
  passes="$CARGO_BUILD_BUILD_DIR/.hook-passes"
  if [ ${#packages[@]} -gt 0 ] && python3 -I scripts/hooks/passes.py check "$passes" "$base" "$lsha" "${inputs[@]}"; then
    packages=()
  fi
  if [ ${#packages[@]} -gt 0 ]; then
    echo "pre-push: running the tests of ${packages[*]}, which this push touches" >&2
    # Except the lift register's freshness (engine.rs), which generate.yml
    # restores on main after every source push from `uorust mir .`, a run
    # no lane makes locally; bootstrap checks it on main's regenerated head.
    # A hook runs with git's GIT_DIR set, which the tests' scratch
    # repositories must not inherit.
    # uorust's engine.rs dumps this workspace's MIR, and that dump's
    # `cargo clean -p uorust` removes uorust's other test binaries from the
    # build dir. So engine.rs runs alone, after every other test target.
    nogit=(env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX)
    first=(--lib --bins)
    for t in crates/uorust/tests/*.rs; do
      [ "$(basename "$t" .rs)" = engine ] || first+=(--test "$(basename "$t" .rs)")
    done
    others=()
    for p in "${packages[@]}"; do
      case $p in -p | uorust) ;; *) others+=(-p "$p") ;; esac
    done
    { if [ ${#others[@]} -gt 0 ]; then "${nogit[@]}" cargo test --locked -q "${others[@]}" "${cfg[@]}"; fi &&
      if [[ " ${packages[*]} " == *" uorust "* ]]; then
        "${nogit[@]}" cargo test --locked -q -p uorust "${cfg[@]}" "${first[@]}" &&
          "${nogit[@]}" cargo test --locked -q -p uorust "${cfg[@]}" --test engine -- --skip no_lifted_kappa_turns_unlifted_ue_16
      fi; } \
      || { echo "pre-push: cargo test ${packages[*]} fails on this push (above)" >&2; exit 1; }
    python3 -I scripts/hooks/passes.py record "$passes" "$base" "$lsha"
  fi
  if [ -n "$(git diff --name-only "$base" "$lsha" -- crates/uorust/src/mir)" ]; then
    echo "pre-push: the push touches crates/uorust/src/mir; running the core register's ratchet on CI's MIR" >&2
    scripts/mir/core-gate.sh "${cfg[@]}" \
      || { echo "pre-push: core-gate refuses this push; its output above says why" >&2; exit 1; }
  fi
done <<<"$pushed"
